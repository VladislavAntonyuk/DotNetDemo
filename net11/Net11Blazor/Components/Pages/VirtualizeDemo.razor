@page "/virtualize"
@rendermode InteractiveServer

<PageTitle>Virtualize</PageTitle>

<h1>Virtualize with variable item height</h1>
<p>10,000 log entries of different heights. The list opens at item 5,000 and stays anchored to the end, like a log viewer.</p>

<div class="mb-3">
    <button class="btn btn-outline-primary" @onclick="() => virtualList.ScrollToItemAsync(0)">First</button>
    <button class="btn btn-outline-primary" @onclick="() => virtualList.ScrollToItemAsync(5000)">Middle</button>
    <button class="btn btn-outline-primary" @onclick="() => virtualList.ScrollToItemAsync(logs.Count - 1)">Last</button>
</div>

<div style="height: 500px; overflow-y: auto; border: 1px solid #ddd;">
    <Virtualize TItem="LogEntry" Items="logs" InitialItemIndex="5000" AnchorMode="VirtualizeAnchorMode.End" @ref="virtualList">
        <div class="p-2 border-bottom">
            <strong>#@context.Id</strong>
            <div style="white-space: pre-line">@context.Message</div>
        </div>
    </Virtualize>
</div>

@code {
    Virtualize<LogEntry> virtualList = default!;

    readonly List<LogEntry> logs = Enumerable.Range(0, 10_000)
        .Select(i => new LogEntry(i, string.Join('\n', Enumerable.Repeat($"Line of log entry {i}", i % 5 + 1))))
        .ToList();
}
